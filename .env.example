# LiveFXHub Feed Credentials
FEED_API_KEY=your_feed_api_key_here
FEED_SECRET=your_feed_secret_here

# Feed Options
FEED_URL=wss://v3-prod.livefxhub.com/ws/algo
FEED_INSECURE_SKIP_VERIFY=false
